{
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "crons": [
    {
      "path": "/api/monthly-report",
      "schedule": "0 7 1 * *"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/reports/how-lucid-io-works-v2.html"
    },
    {
      "source": "/backtest-data",
      "destination": "/reports/backtest-data.html"
    },
    {
      "source": "/backtest-data-usd",
      "destination": "/reports/backtest-data-usd.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/login/:path*",
      "destination": "/login.html"
    },
    {
      "source": "/dashboard",
      "destination": "/login.html"
    },
    {
      "source": "/calendar",
      "destination": "/login.html"
    },
    {
      "source": "/withdraw",
      "destination": "/login.html"
    },
    {
      "source": "/statements",
      "destination": "/login.html"
    },
    {
      "source": "/activity",
      "destination": "/login.html"
    },
    {
      "source": "/about",
      "destination": "/login.html"
    },
    {
      "source": "/profile",
      "destination": "/login.html"
    },
    {
      "source": "/contact",
      "destination": "/login.html"
    },
    {
      "source": "/payout",
      "destination": "/login.html"
    },
    {
      "source": "/fund/:path*",
      "destination": "/login.html"
    },
    {
      "source": "/me/:path*",
      "destination": "/login.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/backtest-data",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/reports/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/reports/bbcore-no-target-three-way.html",
      "destination": "/reports/three-way-comparison.html",
      "permanent": true
    },
    {
      "source": "/reports/bbcore-icore-trades-and-profit.html",
      "destination": "/reports/two-bot-trades-and-profit.html",
      "permanent": true
    },
    {
      "source": "/reports/icore-10k-report.html",
      "destination": "/reports/bot-10k-report.html",
      "permanent": true
    },
    {
      "source": "/reports/icore-vs-current-bot.html",
      "destination": "/reports/alt-bot-vs-current.html",
      "permanent": true
    },
    {
      "source": "/reports/merged-strategies-sol.html",
      "destination": "/reports/merged-strategies-single-market.html",
      "permanent": true
    }
  ]
}
